{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zyren://training/protocol/v1",
  "title": "Zyren training wire v1 metadata",
  "type": "object",
  "required": [
    "version",
    "operation",
    "sequence",
    "run_id",
    "environment_id",
    "episode_id",
    "actor_ids",
    "tick",
    "payload_bytes",
    "tensors",
    "actor_generations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "hello",
        "reset",
        "step",
        "snapshot",
        "restore",
        "close"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "tensors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "name",
          "dtype",
          "shape",
          "offset",
          "length"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dtype": {
            "enum": [
              "f32",
              "f64",
              "i32",
              "u8"
            ]
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "actor_generations": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    }
  },
  "$comment": "The decoder also enforces UTF-8 identity byte bounds, unique tensor names, shape byte counts, non-overlap, complete payload coverage, 64 KiB header and 16 MiB total frame bounds. The prefix is unsigned little-endian uint32 header byte length. Tensor blocks are little-endian and offsets are relative to the raw payload. Negotiation may lower bounds only."
}
