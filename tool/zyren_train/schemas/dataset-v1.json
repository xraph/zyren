{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zyren demonstration dataset v1",
  "type": "object",
  "required": [
    "schema_version",
    "partition",
    "observation_schema_hash",
    "action_schema_hash",
    "game_build_hash",
    "session_id",
    "scenario_hash",
    "recording",
    "episodes",
    "chunks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "partition": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "observation_schema_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
    },
    "action_schema_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
    },
    "game_build_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
    },
    "recording": {
      "type": "object"
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "scenario_hash",
          "session_id",
          "steps",
          "observation_schema_hash",
          "action_schema_hash",
          "game_build_hash",
          "partition",
          "source"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "scenario_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "observation_schema_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "action_schema_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "game_build_hash": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,256}$"
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "partition": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "source": {
            "enum": [
              "player",
              "scripted",
              "policy"
            ]
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "records",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^chunk-[0-9]{6}\\.jsonl$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "records": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          }
        }
      }
    }
  }
}
